Options -Indexes
ServerSignature Off

ErrorDocument 404 /404.php
ErrorDocument 403 /403.php

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Rimuove index.php dall'URL
    RewriteCond %{THE_REQUEST} /index\.php [NC]
    RewriteRule ^index\.php$ / [R=301,L]

    # Rimuove .php dagli URL — ESCLUDI i file che ricevono POST
    RewriteCond %{THE_REQUEST} \.php [NC]
    RewriteCond %{REQUEST_URI} !^/(generate|download|regenerate|send_qr)\.php [NC]
    RewriteRule ^([^.]+)\.php$ /$1 [R=301,L]

    # Serve il file .php quando si visita l'URL senza estensione
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME}\.php -f
    RewriteRule ^([^.]+)$ $1.php [L]
</IfModule>

<IfModule mod_headers.c>
    Header unset X-Powered-By
    Header always unset X-Powered-By
    Header unset Server

    # Clickjacking
    Header always set X-Frame-Options "DENY"

    # MIME sniffing
    Header always set X-Content-Type-Options "nosniff"

    # Referrer
    Header always set Referrer-Policy "no-referrer"

    # Content Security Policy
    Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; frame-ancestors 'none'"

    # HSTS (30 giorni — Cloudflare gestisce HTTPS ma rafforziamo)
    Header always set Strict-Transport-Security "max-age=2592000; includeSubDomains"
</IfModule>
