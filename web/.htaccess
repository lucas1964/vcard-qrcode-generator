Options -Indexes
ServerSignature Off

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Rimuove index.php dall'URL
    RewriteCond %{THE_REQUEST} /index\.php [NC]
    RewriteRule ^index\.php$ / [R=301,L]

    # Rimuove .php dagli URL — ESCLUDI i file che ricevono POST
    RewriteCond %{THE_REQUEST} \.php [NC]
    RewriteCond %{REQUEST_URI} !^/(generate|download)\.php [NC]
    RewriteRule ^([^.]+)\.php$ /$1 [R=301,L]

    # Serve il file .php quando si visita l'URL senza estensione
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME}\.php -f
    RewriteRule ^([^.]+)$ $1.php [L]
</IfModule>

<IfModule mod_headers.c>
    Header unset X-Powered-By
    Header always unset X-Powered-By
    Header unset Server
</IfModule>
